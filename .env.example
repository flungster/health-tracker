# health-tracker environment configuration.
#
# Copy this file to `.env` and adjust values as needed:
#   cp .env.example .env
#
# docker compose reads POSTGRES_* and JWT_* directly. The DATABASE_URL below
# is used by the local (non-docker) development workflow (`make api`).

# --- Postgres (used by docker compose) ---
POSTGRES_USER=healthtracker
POSTGRES_PASSWORD=healthtracker
POSTGRES_DB=health_tracker

# --- API ---
# SQLAlchemy database URL for local development against the compose database.
# (docker compose builds its own URL from POSTGRES_* above.)
DATABASE_URL=postgresql+psycopg://healthtracker:healthtracker@localhost:5432/health_tracker

# Secret used to sign JWT tokens. Use a long random string in production, e.g.
#   openssl rand -hex 32
JWT_SECRET=change-me-in-production
JWT_TOKEN_TTL_DAYS=30

# Directory inside the api container where uploaded activity files are stored.
UPLOADS_DIR=/data/uploads
MAX_UPLOAD_MB=50

# Maximum number of trackpoints in a single imported file; larger files are
# rejected (422 IMPORT_ERROR).
MAX_TRACKPOINTS=100000

# Per-minute limits per client IP on the auth endpoints (brute-force / spam
# protection). Excess requests get 429 + a Retry-After header.
LOGIN_RATE_LIMIT_PER_MINUTE=10
REGISTER_RATE_LIMIT_PER_MINUTE=5

# --- Providers (optional: connect a third-party account, e.g. Strava) ---
# Base URL the browser reaches this deployment at. Used for the OAuth
# redirect URI (when not set below) and the redirect back into the app.
PUBLIC_BASE_URL=http://localhost:9090

# Strava OAuth app (developer.strava.com -> "Your App" -> Create New App).
# Set both to enable Strava; leave empty to run without it. The redirect URI
# must exactly match one configured on the Strava app.
# STRAVA_CLIENT_ID=
# STRAVA_CLIENT_SECRET=
# STRAVA_REDIRECT_URI=          # default: {PUBLIC_BASE_URL}/api/v1/providers/strava/oauth/callback
# STRAVA_SCOPE=activity:read_all

# --- Web ---
# Host port the web application is published on.
WEB_PORT=9090
